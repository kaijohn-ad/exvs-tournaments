{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251014.0",
		"@sveltejs/adapter-cloudflare": "^0.0.1",
		"@sveltejs/kit": "^0.0.30",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/node": "^24.9.1",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^4.0.4",
		"wrangler": "^4.45.0"
	}
}
